{
  "name": "wwi-battle-simulator",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "tools/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "npm run typecheck && vitest run",
    "test:budget": "BUDGET=1 vitest run --project engine-budget",
    "typecheck": "tsc -b",
    "sim": "tsx packages/cli/src/main.ts",
    "app": "npm -w packages/app run dev"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
